# Discord Developer Portal (https://discord.com/developers/applications):
# - DISCORD_BOT_TOKEN: Bot tab -> Reset Token
# - DISCORD_CLIENT_ID / DISCORD_CLIENT_SECRET: OAuth2 tab
# - Add DASHBOARD_BASE_URL + "/auth/discord/callback" as an OAuth2 redirect URI
#   (only the /auth/discord/callback URL needs registering with Discord --
#   /console, where the login flow lands afterwards, is our own internal
#   second hop and does NOT need to be added to the Developer Portal).
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# If testing from your phone against a bot running elsewhere on your
# network, set this to that machine's LAN address, e.g. http://192.168.1.5:8000
DASHBOARD_BASE_URL=http://localhost:8000

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Fixed on purpose: if this changes, every existing session's stored Discord
# tokens become undecryptable and users are silently logged out.
DWA_FERNET_KEY=
