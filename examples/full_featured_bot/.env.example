# Discord Developer Portal (https://discord.com/developers/applications):
# - DISCORD_BOT_TOKEN: Bot tab -> Reset Token
# - DISCORD_CLIENT_ID / DISCORD_CLIENT_SECRET: OAuth2 tab
# - Add DASHBOARD_BASE_URL + "/auth/discord/callback" as an OAuth2 redirect URI
# - Enable BOTH privileged intents (Bot tab): "Server Members Intent"
#   (member listing, every builtin that acts on a member) and "Message
#   Content Intent" (prefix commands like !ping need it to read message
#   text -- without it they silently never fire).
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DASHBOARD_BASE_URL=http://localhost:8000

# Your test server's guild ID -- makes slash commands sync there almost
# instantly instead of waiting up to an hour for a global sync. Leave
# unset for a normal global sync.
TEST_GUILD_ID=

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Fixed on purpose: if this changes, every existing session's stored Discord
# tokens become undecryptable and users are silently logged out.
DWA_FERNET_KEY=

# Optional: point at Postgres/MySQL instead of the default local SQLite
# file. Leave unset to just use SQLite.
# DATABASE_URL=postgresql+asyncpg://user:pass@host/db
