# Discord Developer Portal (https://discord.com/developers/applications):
# - DISCORD_BOT_TOKEN: Bot tab -> Reset Token
# - DISCORD_CLIENT_ID / DISCORD_CLIENT_SECRET: OAuth2 tab
# - Add DASHBOARD_BASE_URL + "/auth/discord/callback" as an OAuth2 redirect URI
# - Enable the "Server Members Intent" privileged intent (Bot tab) --
#   needed for member listing and every builtin that acts on a member.
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DASHBOARD_BASE_URL=http://localhost:8000

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Fixed on purpose: if this changes, every existing session's stored Discord
# tokens become undecryptable and users are silently logged out.
DWA_FERNET_KEY=

# Optional: point at Postgres/MySQL instead of the default local SQLite
# file. Leave unset to just use SQLite.
# DATABASE_URL=postgresql+asyncpg://user:pass@host/db
